# Database
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/omnicrm?schema=public"

# Auth
JWT_SECRET="change-me-to-a-long-random-string"
# Generate once with: openssl rand -base64 32
INTEGRATION_ENCRYPTION_KEY=""

# AI (optional — rule-based fallback works without this)
# Generic OpenAI-compatible chat provider. These take precedence when set.
LLM_API_KEY=""
LLM_BASE_URL=""
LLM_MODEL=""
LLM_PROVIDER=""

# NVIDIA NIM / Integrate API (chat only; uses the OpenAI-compatible endpoint)
NVIDIA_API_KEY=""
NVIDIA_BASE_URL="https://integrate.api.nvidia.com/v1"
NVIDIA_MODEL="nvidia/nemotron-3-super-120b-a12b"

# OpenAI chat and the current 1536-dimension RAG embedding index.
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"
OPENAI_EMBEDDING_MODEL="text-embedding-3-small"

# AiSensy WhatsApp (optional — demo mode without keys)
AISENSY_API_KEY=""
AISENSY_API_URL=""
# AiSensy endpoint for approved template sends; often differs from text sends.
AISENSY_TEMPLATE_API_URL=""
AISENSY_WEBHOOK_SECRET=""
DEFAULT_TENANT_SLUG="demo-sirket"

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"
REDIS_URL="redis://127.0.0.1:6379"
RESEND_API_KEY=""
RESEND_FROM=""
WIDGET_ALLOWED_ORIGINS="https://example.com"
